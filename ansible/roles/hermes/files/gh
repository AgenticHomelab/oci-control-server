#!/bin/sh
# The App token is short-lived and never stored in gh's credential database.
set -eu
unset GH_TOKEN GITHUB_TOKEN
mint_token() {
    if [ -n "${GH_REPO:-}" ]; then
        /usr/bin/sudo -n /usr/local/libexec/hermes-github-app-token "${GH_REPO#github.com/}"
    else
        /usr/bin/sudo -n /usr/local/libexec/hermes-github-app-token
    fi
}
GH_TOKEN="$(mint_token)" || {
    echo "Hermes GitHub App token unavailable" >&2
    exit 1
}
export GH_TOKEN
exec /usr/bin/gh "$@"
