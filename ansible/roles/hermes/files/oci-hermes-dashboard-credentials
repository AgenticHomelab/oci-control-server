#!/usr/bin/env python3
"""One-shot dashboard materialization; no credential-bearing diagnostics."""
import base64
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import resource
import secrets
import selectors
import signal
import stat
import subprocess
import sys
import time

CLI = '/opt/oci-cli/bin/oci'


class RetrievalError(Exception):
    pass


CONFIG = Path('/etc/oci-control-server/vault-hermes-dashboard.json')
LOCK = Path('/etc/oci-control-server/vault-hermes-dashboard.lock')
MIGRATION = Path('/etc/oci-control-server/vault-hermes-dashboard.migrated')
MIGRATION_COMPLETE = b'verified-v1\n'
DESTINATION = Path('/home/hermes/.config/hermes-dashboard.env')


def validate_config(config):
    if not isinstance(config, dict):
        raise RetrievalError()
    if not isinstance(config.get('secret_id'), str) or not re.fullmatch(
            r'ocid1\.vaultsecret\.[A-Za-z0-9.-]+', config['secret_id']):
        raise RetrievalError()
    if not isinstance(config.get('region'), str) or not re.fullmatch(
            r'[a-z]+-[a-z]+-\d+', config['region']):
        raise RetrievalError()
    version = config.get('version_number')
    if version is not None and (type(version) is not int or version < 1):
        raise RetrievalError()

    if not isinstance(config.get('public_url'), str) or not re.fullmatch(
            r'https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?', config['public_url']):
        raise RetrievalError()


def fetch(config):
    argv = [CLI, '--auth', 'instance_principal', '--region', config['region'],
            '--config-file', '/dev/null', '--cli-rc-file', '/dev/null',
            '--no-retry', '--connection-timeout', '5',
            '--read-timeout', '10', '--output', 'json',
            'secrets', 'secret-bundle', 'get', '--secret-id', config['secret_id']]
    version = config.get('version_number')
    argv += ['--stage', 'CURRENT'] if version is None else ['--version-number', str(version)]
    # Ignore inherited debug flags, profiles, endpoints and static OCI credentials.
    return json.loads(run_cli(argv), object_pairs_hook=strict_object)


def run_cli(argv, timeout=45):
    # Drain bounded stdout; discard stderr entirely, including OCI debug/errors.
    with subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, start_new_session=True,
                          env={'PATH': '/usr/bin:/bin', 'HOME': '/root',
                               'LANG': 'C.UTF-8', 'OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING': 'True'}) as process:
        try:
            deadline = time.monotonic() + timeout
            response = bytearray()
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not selector.select(remaining):
                        raise RetrievalError()
                    chunk = os.read(process.stdout.fileno(), 8192)
                    if not chunk:
                        break
                    response.extend(chunk)
                    if len(response) > 65536:
                        raise RetrievalError()
            if process.wait(timeout=max(0, deadline - time.monotonic())):
                raise RetrievalError()
            return bytes(response)
        finally:
            # Also terminate descendants on timeout, interruption and success.
            # No OCI process may outlive the retrieval lock.
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()


@contextmanager
def directory_handle(path):
    # Resolve each component without following symlinks, then use the pinned
    # directory inode for every read/write/rename/unlink operation.
    path = Path(os.path.abspath(path))
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for component in path.parts[1:]:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=fd)
            os.close(fd)
            fd = child
            info = os.fstat(fd)
            # Root-owned sticky /tmp is safe for owner-only test directories.
            sticky = info.st_uid == 0 and info.st_mode & stat.S_ISVTX
            if (info.st_uid not in (0, os.geteuid())
                    or (info.st_mode & 0o022 and not sticky)):
                raise RetrievalError()
        info = os.fstat(fd)
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise RetrievalError()
        yield fd
    finally:
        os.close(fd)


def parse_environment(content):
    """Parse the four-variable EnvironmentFile contract without shell evaluation.

    Follow systemd's unquoted/single/double-quoted value rules, including
    continuations and last-assignment-wins. Reject ambiguous/malformed input
    rather than guessing; this is deliberately not a general dotenv reader.
    """
    text = content.decode('utf-8')
    if any((ord(c) < 32 and c not in '\t\n\r') or ord(c) == 127
           or ord(c) == 0xfeff or 0xfdd0 <= ord(c) <= 0xfdef
           or ord(c) & 0xffff in (0xfffe, 0xffff) for c in text):
        raise RetrievalError()
    expected = {'HERMES_DASHBOARD_PUBLIC_URL',
                'HERMES_DASHBOARD_BASIC_AUTH_USERNAME',
                'HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH',
                'HERMES_DASHBOARD_BASIC_AUTH_SECRET'}
    result = {}
    i = 0
    while i < len(text):
        if text[i] in ' \t\r\n':
            i += 1
            continue
        if text[i] in '#;':
            end = text.find('\n', i)
            end = len(text) if end < 0 else end
            # Comment continuation semantics vary across systemd versions.
            if '\\' in text[i:end]:
                raise RetrievalError()
            i = end
            continue
        start = i
        while i < len(text) and text[i] not in '=\n':
            i += 1
        if i == len(text) or text[i] != '=':
            raise RetrievalError()
        key = text[start:i].rstrip(' \t\r')
        if key not in expected:
            raise RetrievalError()
        i += 1
        value = []
        state = 'before'
        trailing = None
        while i < len(text):
            c = text[i]
            i += 1
            if state == 'single':
                if c == "'":
                    state = 'before'
                else:
                    value.append(c)
            elif state == 'double':
                if c == '"':
                    state = 'before'
                elif c == '\\':
                    state = 'double_escape'
                else:
                    value.append(c)
            elif state == 'double_escape':
                if c in '\\"`$':
                    value.append(c)
                elif c != '\n':
                    value.extend(('\\', c))
                state = 'double'
            elif state == 'escape':
                if c != '\n':
                    value.append(c)
                state = 'unquoted'
            else:
                if c == '\n':
                    break
                if c == '\\':
                    state = 'escape'
                    trailing = None
                elif state == 'before' and c in "'\"":
                    state = 'single' if c == "'" else 'double'
                elif state == 'before' and c in ' \t\r':
                    continue
                else:
                    state = 'unquoted'
                    if c in ' \t\r':
                        if trailing is None:
                            trailing = len(value)
                    else:
                        trailing = None
                    value.append(c)
        if state in ('single', 'double', 'double_escape', 'escape'):
            raise RetrievalError()
        if state == 'unquoted' and trailing is not None:
            value = value[:trailing]
        result[key] = ''.join(value)
    if set(result) != expected or any(not value.strip() for value in result.values()):
        raise RetrievalError()
    return result


def atomic_install(path, content, *, verify_only=False, allow_rotation=False):
    with directory_handle(path.parent) as directory:
        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                     dir_fd=directory)
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_gid != os.getegid() or stat.S_IMODE(info.st_mode) != 0o600):
            os.close(fd)
            raise RetrievalError()
        with os.fdopen(fd, 'rb') as current:
            previous = current.read(8193)
        if len(previous) > 8192:
            raise RetrievalError()
        existing = parse_environment(previous)
        selected = parse_environment(content)
        # The consumer strips surrounding whitespace. Compare strings, never
        # hashes/fingerprints, and never decode or normalize the signing secret.
        if existing['HERMES_DASHBOARD_PUBLIC_URL'].strip() != selected['HERMES_DASHBOARD_PUBLIC_URL']:
            raise RetrievalError()
        equivalent = all(existing[key].strip() == value for key, value in selected.items())
        if (verify_only or not allow_rotation) and not equivalent:
            raise RetrievalError()
        # Keep equivalent serialization and its inode, including in verify mode.
        if verify_only or equivalent:
            return False
        temporary = '.vault-hermes-dashboard-' + secrets.token_hex(16)
        fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW,
                     0o600, dir_fd=directory)
        try:
            with os.fdopen(fd, 'wb') as output:
                os.fchmod(output.fileno(), 0o600)
                os.fchown(output.fileno(), os.geteuid(), os.getegid())
                output.write(content)
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, path.name, src_dir_fd=directory, dst_dir_fd=directory)
        finally:
            try:
                os.unlink(temporary, dir_fd=directory)
            except FileNotFoundError:
                pass
    return True


def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise RetrievalError()
        result[key] = value
    return result


def validate_credentials(payload):
    if (not isinstance(payload, dict)
            or set(payload) != {'schema_version', 'username', 'password_hash', 'auth_secret'}
            or type(payload['schema_version']) is not int or payload['schema_version'] != 1):
        raise RetrievalError()
    for field in ('username', 'password_hash', 'auth_secret'):
        value = payload[field]
        if (not isinstance(value, str) or not value or value != value.strip()
                or len(value.encode('utf-8')) > 4096
                or any(ord(c) < 32 or ord(c) == 127 for c in value)):
            raise RetrievalError()
    if len(payload['auth_secret'].encode('utf-8')) < 16:
        raise RetrievalError()
    # Validate the consumer's six-part scrypt representation, without hashing,
    # rewriting salts/digests or interpreting the session secret's encoding.
    parts = payload['password_hash'].split('$')
    if len(parts) != 6 or parts[0] != 'scrypt':
        raise RetrievalError()
    if any(not re.fullmatch(r'[1-9][0-9]{0,9}', p) for p in parts[1:4]):
        raise RetrievalError()
    n, r, p = map(int, parts[1:4])
    if n < 2 or n & (n - 1) or r < 1 or p < 1:
        raise RetrievalError()
    # Match OpenSSL scrypt's mathematical constraints and the consumer's
    # maxmem=0 default budget (32 MiB). Never execute attacker-chosen KDF work
    # just to validate a bundle. Unsupported existing hashes block cutover.
    memory = 128 * r * (n + p + 2)
    if r * p >= 2**30 or n.bit_length() - 1 >= 16 * r or memory > 32 * 1024 * 1024:
        raise RetrievalError()
    for encoded in parts[4:]:
        if not base64.b64decode(encoded, validate=True):
            raise RetrievalError()
    return payload


def environment_value(value):
    # Preserve the existing unquoted representation for ordinary values.
    # systemd EnvironmentFile does not perform shell/$ expansion.
    if not any(c.isspace() or c in '\\"\'' for c in value):
        return value
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"') + '"'


def render(payload, public_url):
    validate_credentials(payload)
    lines = [('HERMES_DASHBOARD_PUBLIC_URL', public_url),
             ('HERMES_DASHBOARD_BASIC_AUTH_USERNAME', payload['username']),
             ('HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH', payload['password_hash']),
             ('HERMES_DASHBOARD_BASIC_AUTH_SECRET', payload['auth_secret'])]
    content = ''.join(key + '=' + environment_value(value) + '\n' for key, value in lines).encode('utf-8')
    if len(content) >= 8192:
        raise RetrievalError()
    return content


def decode_bundle(response, config):
    try:
        data = response['data']
        version = data['version-number']
        if data['secret-id'] != config['secret_id'] or type(version) is not int or version < 1:
            raise RetrievalError()
        selected = config.get('version_number')
        if selected is None:
            if not isinstance(data['stages'], list) or 'CURRENT' not in data['stages']:
                raise RetrievalError()
        elif selected != version:
            raise RetrievalError()
        content = data['secret-bundle-content']
        if content['content-type'] != 'BASE64':
            raise RetrievalError()
        raw = base64.b64decode(content['content'], validate=True)
        if len(raw) > 8192:
            raise RetrievalError()
        payload = json.loads(raw, object_pairs_hook=strict_object)
        return render(payload, config['public_url'])
    except (KeyError, TypeError, ValueError, UnicodeError):
        raise RetrievalError() from None


def protected_file(path, flags):
    with directory_handle(path.parent) as directory:
        fd = os.open(path.name, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600, dir_fd=directory)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) != 0o600):
        os.close(fd)
        raise RetrievalError()
    return fd


def drop_to_hermes():
    account = pwd.getpwnam('hermes')
    if account.pw_uid == 0 or account.pw_gid == 0 or account.pw_dir != '/home/hermes':
        raise RetrievalError()
    os.setgroups([])
    os.setgid(account.pw_gid)
    os.setuid(account.pw_uid)


@contextmanager
def migration_receipt(verify_only):
    if verify_only:
        yield None
    else:
        with os.fdopen(protected_file(MIGRATION, os.O_CREAT | os.O_RDWR), 'r+b') as receipt:
            yield receipt


def main():
    try:
        arguments = sys.argv[1:]
        if arguments not in ([], ['--verify-only'], ['--allow-rotation']):
            raise RetrievalError()
        verify_only = arguments == ['--verify-only']
        allow_rotation = arguments == ['--allow-rotation']
        if os.geteuid() != 0:
            raise RetrievalError()
        def interrupted(signum, frame):
            raise RetrievalError()
        for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(signum, interrupted)
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        os.umask(0o077)
        os.setegid(0)
        with os.fdopen(protected_file(LOCK, os.O_CREAT | os.O_RDWR), 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            with os.fdopen(protected_file(CONFIG, os.O_RDONLY), 'rb') as source:
                metadata = source.read(8193)
            if len(metadata) > 8192:
                raise RetrievalError()
            config = json.loads(metadata, object_pairs_hook=strict_object)
            validate_config(config)
            content = decode_bundle(fetch(config), config)
            # A root-owned, non-secret receipt prevents the rotation switch
            # from bypassing the first migration. Keep only this narrow writable
            # descriptor across the irreversible privilege drop.
            with migration_receipt(verify_only) as receipt:
                if allow_rotation and receipt.read(32) != MIGRATION_COMPLETE:
                    raise RetrievalError()
                # Never traverse a user-owned path or open/write its files as root.
                drop_to_hermes()
                changed = atomic_install(DESTINATION, content,
                                         verify_only=verify_only, allow_rotation=allow_rotation)
                if not verify_only and not allow_rotation:
                    receipt.seek(0)
                    receipt.write(MIGRATION_COMPLETE)
                    receipt.truncate()
                    receipt.flush()
                    os.fsync(receipt.fileno())
        print('verified' if verify_only else ('changed' if changed else 'unchanged'))
        return 0
    except Exception:
        print('Vault dashboard refresh failed; no incomplete credentials installed.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
