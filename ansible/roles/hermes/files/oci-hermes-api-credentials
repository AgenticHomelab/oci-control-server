#!/usr/bin/python3 -I
"""Verify pinned Vault API credentials against retained Hermes-owned dotenv.

No shared-environment writer or external secret provider is introduced. The
existing pinned dotenv/profile consumer keeps its original materialization;
all reconciliation requires exact selected-version equality. No rotation.
"""

import base64
import fcntl
import json
import os
import pwd
import re
import resource
import selectors
import signal
import stat
import subprocess
import sys
import time
from io import StringIO
from pathlib import Path

from dotenv.parser import parse_stream

CLI = "/opt/oci-cli/bin/oci"
METADATA = Path("/etc/oci-control-server/vault-hermes-api.json")
RECEIPT = Path("/etc/oci-control-server/vault-hermes-api.migrated")
LOCK = Path("/etc/oci-control-server/vault-hermes-api.lock")
ENVIRONMENT = Path("/home/hermes/.hermes/.env")
OWNER = 0
COMPLETE = b"verified-v1\n"


class RetrievalError(Exception):
    pass


def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise RetrievalError()
        result[key] = value
    return result


def safe_open(path, flags=os.O_RDONLY):
    # Pin every ancestor, then resolve the leaf relative to the last directory.
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.absolute().parts[1:-1]:
            next_fd = os.open(
                part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd
            )
            os.close(fd)
            fd = next_fd
            info = os.fstat(fd)
            if info.st_uid not in {0, OWNER} or stat.S_IMODE(info.st_mode) & 0o022:
                raise RetrievalError()
        leaf = os.open(
            path.name, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600, dir_fd=fd
        )
        info = os.fstat(leaf)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != OWNER
            or info.st_gid != OWNER
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_nlink != 1
        ):
            os.close(leaf)
            raise RetrievalError()
        return leaf
    finally:
        os.close(fd)


def read_file(path):
    with os.fdopen(safe_open(path), "rb") as stream:
        content = stream.read(131073)
        if len(content) > 131072:
            raise RetrievalError()
        return content


def validate_config(config):
    if not isinstance(config, dict) or set(config) != {
        "secret_id",
        "region",
        "version_number",
    }:
        raise RetrievalError()
    if (
        not isinstance(config["secret_id"], str)
        or not re.fullmatch(r"ocid1\.vaultsecret\.[A-Za-z0-9.-]+", config["secret_id"])
        or not isinstance(config["region"], str)
        or not re.fullmatch(r"[a-z]+-[a-z]+-[0-9]+", config["region"])
        or type(config["version_number"]) is not int
        or config["version_number"] < 1
    ):
        raise RetrievalError()
    return config


def validate_payload(payload):
    if (
        not isinstance(payload, dict)
        or set(payload) != {"schema_version", "api_server_key"}
        or type(payload["schema_version"]) is not int
        or payload["schema_version"] != 1
        or not isinstance(payload["api_server_key"], str)
        or not re.fullmatch(r"[A-Za-z0-9_+./=~-]{32,2048}", payload["api_server_key"])
    ):
        raise RetrievalError()
    return payload


def read_environment():
    account = pwd.getpwnam("hermes")
    directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in ENVIRONMENT.absolute().parts[1:-1]:
            next_fd = os.open(
                part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory
            )
            os.close(directory)
            directory = next_fd
            info = os.fstat(directory)
            if (
                info.st_uid not in {0, account.pw_uid}
                or stat.S_IMODE(info.st_mode) & 0o022
            ):
                raise RetrievalError()
        fd = os.open(
            ENVIRONMENT.name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
            dir_fd=directory,
        )
        with os.fdopen(fd, "rb") as source:
            info = os.fstat(source.fileno())
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != account.pw_uid
                or info.st_gid != account.pw_gid
                or stat.S_IMODE(info.st_mode) != 0o600
                or info.st_nlink != 1
            ):
                raise RetrievalError()
            content = source.read(131073)
            if len(content) > 131072:
                raise RetrievalError()
            return content
    finally:
        os.close(directory)


def environment_key(content):
    values = {}
    for binding in parse_stream(StringIO(content.decode("utf-8"))):
        if binding.error or (binding.key is not None and binding.key in values):
            raise RetrievalError()
        if binding.key is not None:
            values[binding.key] = binding.value
    key = values.get("API_SERVER_KEY")
    validate_payload({"schema_version": 1, "api_server_key": key})
    return key


def decode_bundle(response, config):
    data = response["data"]
    if (
        data["secret-id"] != config["secret_id"]
        or type(data["version-number"]) is not int
        or data["version-number"] != config["version_number"]
    ):
        raise RetrievalError()
    body = data["secret-bundle-content"]
    if (
        body["content-type"] != "BASE64"
        or not isinstance(body["content"], str)
        or len(body["content"]) > 16384
    ):
        raise RetrievalError()
    return validate_payload(
        json.loads(
            base64.b64decode(body["content"], validate=True).decode("utf-8"),
            object_pairs_hook=strict_object,
        )
    )


def fetch(config):
    argv = [
        CLI,
        "--auth",
        "instance_principal",
        "--region",
        config["region"],
        "--config-file",
        "/dev/null",
        "--cli-rc-file",
        "/dev/null",
        "--no-retry",
        "--connection-timeout",
        "5",
        "--read-timeout",
        "10",
        "--output",
        "json",
        "secrets",
        "secret-bundle",
        "get",
        "--secret-id",
        config["secret_id"],
        "--version-number",
        str(config["version_number"]),
    ]
    return decode_bundle(
        json.loads(run_cli(argv), object_pairs_hook=strict_object), config
    )


def run_cli(argv, timeout=45):
    # Drain bounded stdout; discard stderr entirely, including OCI debug/errors.
    with subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        env={
            "PATH": "/usr/bin:/bin",
            "HOME": "/root",
            "LANG": "C.UTF-8",
            "OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING": "True",
        },
    ) as process:
        try:
            deadline = time.monotonic() + timeout
            response = bytearray()
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not selector.select(remaining):
                        raise RetrievalError()
                    chunk = os.read(process.stdout.fileno(), 8192)
                    if not chunk:
                        break
                    response.extend(chunk)
                    if len(response) > 65536:
                        raise RetrievalError()
            if process.wait(timeout=max(0, deadline - time.monotonic())):
                raise RetrievalError()
            return bytes(response)
        finally:
            # Also terminate descendants on timeout, interruption and success.
            # No OCI process may outlive the retrieval lock.
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()


def reconcile(verify_only=False):
    with os.fdopen(safe_open(LOCK, os.O_CREAT | os.O_RDWR), "r+b") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        config = validate_config(
            json.loads(read_file(METADATA), object_pairs_hook=strict_object)
        )
        if (RECEIPT.exists() or RECEIPT.is_symlink()) and read_file(
            RECEIPT
        ) != COMPLETE:
            raise RetrievalError()
        payload = fetch(config)
        content = read_environment()
        if environment_key(content) != payload["api_server_key"]:
            raise RetrievalError()
        if read_environment() != content:
            raise RetrievalError()
        if not verify_only and not RECEIPT.exists():
            with os.fdopen(
                safe_open(RECEIPT, os.O_CREAT | os.O_EXCL | os.O_WRONLY), "wb"
            ) as marker:
                marker.write(COMPLETE)
                marker.flush()
                os.fsync(marker.fileno())
        return "verified" if verify_only else "unchanged"


def main():
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    try:
        if os.geteuid() != 0 or sys.argv[1:] not in ([], ["--verify-only"]):
            raise RetrievalError()
        print(reconcile(sys.argv[1:] == ["--verify-only"]))
        return 0
    except BaseException:  # noqa: BLE001 - sanitize failures including interruption
        print(
            "Hermes API credential verification failed; environment retained.",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    sys.exit(main())
