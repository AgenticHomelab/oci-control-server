[Unit]
Description=Hermes Agent Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hermes/.hermes
Environment=HOME=/home/hermes
Environment=HERMES_HOME=/home/hermes/.hermes
EnvironmentFile=/home/hermes/.config/hermes-dashboard.env
ExecStart=/home/hermes/.local/bin/hermes dashboard --host {{ hermes_dashboard_bind_address }} --port {{ hermes_dashboard_port }} --no-open
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
