[Unit]
Description=Renew only Hermes Omni service-account PGP key
Wants=network-online.target
After=network-online.target
OnFailure=control-failure@%n.service

[Service]
Type=oneshot
User=hermes
Group=hermes
UMask=0077
WorkingDirectory=/home/hermes
ExecStart=/bin/bash -c 'set +x; set -eu; set -a; . {{ hermes_omni_credential_file }}; set +a; exec /usr/bin/python3 /usr/local/libexec/hermes-omni-key-renew'
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.config/hermes

[Install]
WantedBy=multi-user.target
