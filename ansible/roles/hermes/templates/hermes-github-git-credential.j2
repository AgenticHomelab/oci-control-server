#!/usr/bin/python3
"""Git HTTPS credential helper restricted to approved homelab repositories."""
import subprocess
import sys

ALLOWED = set({{ (hermes_github_app_organization_repositories.keys() | list) | to_json }})


def main():
    if sys.argv[1:] != ["get"]:
        return 0
    data = sys.stdin.read(8192)
    fields = dict(line.split("=", 1) for line in data.splitlines() if "=" in line)
    repository = fields.get("path", "").lower().removesuffix(".git")
    if (fields.get("protocol") != "https"
            or fields.get("host") != "github.com"
            or repository not in ALLOWED):
        return 0
    command = ["/usr/bin/sudo", "-n",
               "/usr/local/libexec/hermes-github-app-token", repository]
    result = subprocess.run(command, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                            timeout=25, check=False)
    if result.returncode or len(result.stdout) > 8192:
        return 1
    value = result.stdout.decode("ascii").strip()
    if not value or any(char.isspace() for char in value):
        return 1
    print("username=x-access-token")
    print("password=" + value)
    return 0


if __name__ == "__main__":
    try:
        status = main()
    except BaseException:
        status = 1
    sys.exit(status)
