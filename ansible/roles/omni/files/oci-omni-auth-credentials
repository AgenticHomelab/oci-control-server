#!/usr/bin/python3 -I
"""Verify a coupled, retained Omni/Dex configuration against pinned Vault data.

No rotation or credential-file installation is permitted. The commit point is
one non-secret receipt after the complete existing configuration compares equal.
Replacement hosts bootstrap the retained files through the explicit environment
path or independent recovery, then verify before selecting Vault.
"""

import base64
import fcntl
import json
import os
import re
import resource
import selectors
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path

import yaml

CLI = "/opt/oci-cli/bin/oci"
METADATA = Path("/etc/oci-control-server/vault-omni-auth.json")
RECEIPT = Path("/etc/oci-control-server/vault-omni-auth.migrated")
LOCK = Path("/etc/oci-control-server/vault-omni-auth.lock")
FILES = [
    Path("/opt/omni/.env"),
    Path("/opt/omni/secrets/omni-oidc.yaml"),
    Path("/opt/omni/config/dex.yaml"),
]
OWNER = 0
COMPLETE = b"verified-v1\n"


class RetrievalError(Exception):
    pass


def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise RetrievalError()
        result[key] = value
    return result


class UniqueLoader(yaml.SafeLoader):
    pass


def unique_mapping(loader, node):
    if any(key.value == "<<" for key, _ in node.value):
        raise RetrievalError()
    return strict_object(
        (loader.construct_object(k), loader.construct_object(v)) for k, v in node.value
    )


UniqueLoader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, unique_mapping
)


def yaml_object(content):
    if any(isinstance(event, yaml.AliasEvent) for event in yaml.parse(content)):
        raise RetrievalError()
    return yaml.load(content, Loader=UniqueLoader)


def safe_open(path, flags=os.O_RDONLY):
    # Pin every ancestor, then resolve the leaf relative to the last directory.
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.absolute().parts[1:-1]:
            next_fd = os.open(
                part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd
            )
            os.close(fd)
            fd = next_fd
            info = os.fstat(fd)
            if info.st_uid not in {0, OWNER} or stat.S_IMODE(info.st_mode) & 0o022:
                raise RetrievalError()
        leaf = os.open(
            path.name, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600, dir_fd=fd
        )
        info = os.fstat(leaf)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != OWNER
            or info.st_gid != OWNER
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_nlink != 1
        ):
            os.close(leaf)
            raise RetrievalError()
        return leaf
    finally:
        os.close(fd)


def read_file(path):
    with os.fdopen(safe_open(path), "rb") as stream:
        content = stream.read(131073)
        if len(content) > 131072:
            raise RetrievalError()
        return content


def validate_config(config):
    fields = {
        "secret_id",
        "region",
        "version_number",
        "account_uuid",
        "user_email",
        "admin_email",
        "admin_username",
        "hostname",
        "bind_address",
    }
    if not isinstance(config, dict) or set(config) != fields:
        raise RetrievalError()
    if not all(
        isinstance(config[k], str)
        and config[k]
        and not any(ord(c) < 32 for c in config[k])
        for k in fields - {"version_number"}
    ):
        raise RetrievalError()
    if (
        not re.fullmatch(r"ocid1\.vaultsecret\.[A-Za-z0-9.-]+", config["secret_id"])
        or not re.fullmatch(r"[a-z]+-[a-z]+-[0-9]+", config["region"])
        or type(config["version_number"]) is not int
        or config["version_number"] < 1
        or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]*", config["hostname"])
    ):
        raise RetrievalError()
    return config


def validate_payload(payload):
    if (
        not isinstance(payload, dict)
        or set(payload)
        != {"schema_version", "oidc_client_secret", "dex_admin_password_hash"}
        or type(payload["schema_version"]) is not int
        or payload["schema_version"] != 1
    ):
        raise RetrievalError()
    secret = payload["oidc_client_secret"]
    hashed = payload["dex_admin_password_hash"]
    # This consumer contract is deliberately narrow: no Compose substitution,
    # whitespace or escaping ambiguity, and no plaintext Dex password.
    if not isinstance(secret, str) or not re.fullmatch(
        r"[A-Za-z0-9_+./=~-]{16,2048}", secret
    ):
        raise RetrievalError()
    if not isinstance(hashed, str) or not re.fullmatch(
        r"\$2[aby]\$(?:0[4-9]|1[0-6])\$[./A-Za-z0-9]{53}", hashed
    ):
        raise RetrievalError()
    return payload


def decode_bundle(response, config):
    data = response["data"]
    if (
        data["secret-id"] != config["secret_id"]
        or type(data["version-number"]) is not int
        or data["version-number"] != config["version_number"]
    ):
        raise RetrievalError()
    body = data["secret-bundle-content"]
    if (
        body["content-type"] != "BASE64"
        or not isinstance(body["content"], str)
        or len(body["content"]) > 16384
    ):
        raise RetrievalError()
    return validate_payload(
        json.loads(
            base64.b64decode(body["content"], validate=True).decode("utf-8"),
            object_pairs_hook=strict_object,
        )
    )


def fetch(config):
    argv = [
        CLI,
        "--auth",
        "instance_principal",
        "--region",
        config["region"],
        "--config-file",
        "/dev/null",
        "--cli-rc-file",
        "/dev/null",
        "--no-retry",
        "--connection-timeout",
        "5",
        "--read-timeout",
        "10",
        "--output",
        "json",
        "secrets",
        "secret-bundle",
        "get",
        "--secret-id",
        config["secret_id"],
        "--version-number",
        str(config["version_number"]),
    ]
    return decode_bundle(
        json.loads(run_cli(argv), object_pairs_hook=strict_object), config
    )


def run_cli(argv, timeout=45):
    # Drain bounded stdout; discard stderr entirely, including OCI debug/errors.
    with subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        env={
            "PATH": "/usr/bin:/bin",
            "HOME": "/root",
            "LANG": "C.UTF-8",
            "OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING": "True",
        },
    ) as process:
        try:
            deadline = time.monotonic() + timeout
            response = bytearray()
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not selector.select(remaining):
                        raise RetrievalError()
                    chunk = os.read(process.stdout.fileno(), 8192)
                    if not chunk:
                        break
                    response.extend(chunk)
                    if len(response) > 65536:
                        raise RetrievalError()
            if process.wait(timeout=max(0, deadline - time.monotonic())):
                raise RetrievalError()
            return bytes(response)
        finally:
            # Also terminate descendants on timeout, interruption and success.
            # No OCI process may outlive the retrieval lock.
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()


def verify_files(contents, payload, config):
    # Stage all three existing files in bounded memory before comparing any.
    # Reject unsupported Compose dotenv serialization rather than guessing its
    # interpolation semantics. Ordinary equivalent YAML quoting is supported.
    env = {}
    for line in contents[0].decode("utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"([A-Z_]+)=([A-Za-z0-9_+./=@~-]+)", line)
        if not match or match[1] in env:
            raise RetrievalError()
        env[match[1]] = match[2]
    if env != {
        "OMNI_ACCOUNT_UUID": config["account_uuid"],
        "OMNI_USER_EMAIL": config["user_email"],
        "OMNI_OIDC_CLIENT_SECRET": payload["oidc_client_secret"],
    }:
        raise RetrievalError()
    if yaml_object(contents[1]) != {
        "auth": {"oidc": {"clientSecret": payload["oidc_client_secret"]}}
    }:
        raise RetrievalError()
    dex = yaml_object(contents[2])
    expected = {
        "issuer": "https://" + config["hostname"] + ":5556",
        "storage": {"type": "memory"},
        "web": {
            "https": config["bind_address"] + ":5556",
            "tlsCert": "/etc/dex/tls/fullchain.pem",
            "tlsKey": "/etc/dex/tls/key.pem",
        },
        "enablePasswordDB": True,
        "staticClients": [
            {
                "name": "Omni",
                "id": "omni",
                "secretEnv": "OMNI_OIDC_CLIENT_SECRET",
                "redirectURIs": ["https://" + config["hostname"] + "/oidc/consume"],
            }
        ],
        "staticPasswords": [
            {
                "email": config["admin_email"],
                "username": config["admin_username"],
                "preferredUsername": config["admin_username"],
                "hash": payload["dex_admin_password_hash"],
            }
        ],
    }
    if dex != expected:
        raise RetrievalError()


def reconcile(verify_only=False):
    with os.fdopen(safe_open(LOCK, os.O_CREAT | os.O_RDWR), "r+b") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        config = validate_config(
            json.loads(read_file(METADATA), object_pairs_hook=strict_object)
        )
        if (RECEIPT.exists() or RECEIPT.is_symlink()) and read_file(
            RECEIPT
        ) != COMPLETE:
            raise RetrievalError()
        payload = fetch(config)
        contents = [read_file(path) for path in FILES]
        verify_files(contents, payload, config)
        # Recheck the complete staged set before publishing the receipt. No
        # credential-file write, move, permission change or service invocation.
        if any(read_file(path) != content for path, content in zip(FILES, contents)):
            raise RetrievalError()
        if not verify_only and not RECEIPT.exists():
            with os.fdopen(
                safe_open(RECEIPT, os.O_CREAT | os.O_EXCL | os.O_WRONLY), "wb"
            ) as marker:
                marker.write(COMPLETE)
                marker.flush()
                os.fsync(marker.fileno())
        return "verified" if verify_only else "unchanged"


def main():
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    try:
        if os.geteuid() != 0 or sys.argv[1:] not in ([], ["--verify-only"]):
            raise RetrievalError()
        print(reconcile(sys.argv[1:] == ["--verify-only"]))
        return 0
    except BaseException:  # noqa: BLE001 - sanitize failures including interruption
        print(
            "Omni authentication verification failed; configuration retained.",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    sys.exit(main())
