      "datasource": {
        "type": "prometheus",
        "uid": "control-victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by(namespace)(kube_pod_container_status_restarts_total{cluster=\"$cluster\",job=\"talos/kube-state-metrics\"}))",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
