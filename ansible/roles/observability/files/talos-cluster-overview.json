    {
      "id": 16,
      "type": "timeseries",
      "title": "Remote-write backlog timestamp lag",
      "description": "Difference between highest received and successfully sent timestamps; inspect sample freshness too.",
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "control-victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(max(prometheus_remote_storage_highest_timestamp_in_seconds{cluster=\"$cluster\",job=\"talos/alloy\"}) - max(prometheus_remote_storage_queue_highest_sent_timestamp_seconds{cluster=\"$cluster\",job=\"talos/alloy\"}), 0)",
          "legendFormat": "Queued timestamp - sent timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
