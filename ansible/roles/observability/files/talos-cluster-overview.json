    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container restarts by namespace (top 10)",
      "description": "Current container restart counters; not unique failures or a durable event log.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
