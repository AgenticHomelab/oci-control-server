          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Unavailable Deployments (top 10)",
      "description": "No data means no unavailable Deployments only when scrape health and freshness are good; otherwise availability is unknown.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
