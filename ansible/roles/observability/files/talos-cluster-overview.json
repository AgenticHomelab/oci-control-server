{
  "uid": "talos-cluster-overview",
  "title": "Talos Kubernetes overview",
  "description": "Kubernetes state, actual kubelet CPU/memory usage and collector health. Private kubelet server TLS verification is temporarily disabled; OCI remote-write TLS remains verified. Missing metrics remain No data.",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "tags": [
    "talos",
    "kubernetes"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "control-victoriametrics"
        },
        "query": "label_values(up{job=\"talos/kube-state-metrics\"}, cluster)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "talos-home",
          "value": "talos-home"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and missing data",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Actual CPU usage is a five-minute rate in cores; memory usage is the working set in bytes. Requests, limits and allocatable resources describe configuration, not consumption. Pod namespace totals do not add container metrics. Kubelet server verification is temporarily disabled only for the private kubelet scrape; OCI remote-write TLS remains verified. Projected-token file refresh verified by metadata on 2026-10-15; subsequent kubelet scrapes remained healthy. No data means absent/unavailable telemetry, never zero. Remote-write self-metrics also stop arriving during an outage; check freshness first."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scrape / ingestion health",
      "description": "Stored scrape health; inspect freshness to detect stalled ingestion.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "control-victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{cluster=\"$cluster\",job=~\"talos/(alloy|kube-state-metrics)\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sample freshness",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "control-victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - timestamp(up{cluster=\"$cluster\",job=~\"talos/(alloy|kube-state-metrics)\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Nodes Ready / total",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "control-victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{cluster=\"$cluster\",job=\"talos/kube-state-metrics\",condition=\"Ready\",status=\"true\"})",
          "legendFormat": "Ready"
        },
        {
          "refId": "B",
          "expr": "count(kube_node_status_condition{cluster=\"$cluster\",job=\"talos/kube-state-metrics\",condition=\"Ready\",status=\"true\"})",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
