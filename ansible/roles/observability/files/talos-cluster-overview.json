    {
      "id": 15,
      "type": "timeseries",
      "title": "Remote-write failed / retried samples per second",
      "description": "Retry counts are attempts, not evidence of sample loss. Failed samples and freshness require investigation.",
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "control-victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prometheus_remote_storage_samples_failed_total{cluster=\"$cluster\",job=\"talos/alloy\"}[$__rate_interval]))",
          "legendFormat": "Failed /s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(prometheus_remote_storage_samples_retried_total{cluster=\"$cluster\",job=\"talos/alloy\"}[$__rate_interval]))",
          "legendFormat": "Retried /s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
