      "datasource": {
        "type": "prometheus",
        "uid": "control-victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,phase)(kube_pod_status_phase{cluster=\"$cluster\",job=\"talos/kube-state-metrics\"} == 1)",
          "legendFormat": "{{namespace}} / {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
