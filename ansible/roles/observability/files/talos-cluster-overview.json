      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, (kube_deployment_spec_replicas{cluster=\"$cluster\",job=\"talos/kube-state-metrics\"} - kube_deployment_status_replicas_available{cluster=\"$cluster\",job=\"talos/kube-state-metrics\"}) > 0)",
          "legendFormat": "{{namespace}} / {{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
