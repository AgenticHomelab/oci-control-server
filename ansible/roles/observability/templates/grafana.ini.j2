; Managed by Ansible. Password content is never rendered by Ansible.
[paths]
data = /var/lib/grafana
logs = /var/log/grafana
plugins = /var/lib/grafana/plugins
provisioning = /etc/grafana/provisioning

[server]
protocol = http
http_addr = 127.0.0.1
http_port = 3000
domain = localhost
root_url = http://localhost:3000/
enforce_domain = true

[security]
admin_user = admin
admin_password = $__file{ {{- observability_grafana_password_file -}} }
secret_key = $__file{/etc/oci-control-server/grafana/secret-key}
disable_gravatar = true
cookie_samesite = strict

[auth]
disable_login_form = false

[auth.basic]
enabled = true

[auth.anonymous]
enabled = false

[users]
allow_sign_up = false
allow_org_create = false

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[log]
mode = console
