server {
    listen {{ tailscale_ipv4_address }}:443 ssl;
    http2 on;
    server_name {{ omni_hostname }};

    ssl_certificate /etc/letsencrypt/live/{{ omni_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ omni_certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        error_page 418 = @grpc;
        error_page 419 = @http;

        if ($is_grpc) {
            return 418;
        }

        return 419;
    }

    location @grpc {
        grpc_read_timeout 1h;
        grpc_send_timeout 1h;
        grpc_pass grpc://127.0.0.1:8080;
    }

    location @http {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }
}
