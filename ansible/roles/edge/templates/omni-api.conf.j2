server {
    listen {{ omni_api_bind_address }}:443 ssl;
    http2 on;
    server_name {{ omni_api_hostname }};

    ssl_certificate /etc/letsencrypt/live/{{ omni_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ omni_certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        grpc_read_timeout 1h;
        grpc_send_timeout 1h;
        grpc_pass grpc://127.0.0.1:8090;
    }
}
