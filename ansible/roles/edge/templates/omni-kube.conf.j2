server {
    listen {{ tailscale_ipv4_address }}:443 ssl;
    http2 on;
    server_name {{ omni_kube_hostname }};

    ssl_certificate /etc/letsencrypt/live/{{ omni_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ omni_certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }
}
